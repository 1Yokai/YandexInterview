add("Random Pick with Weight",
    {"kind": "random_pick", "tests": [{"w": [1,3]},{"w": [1,1,1,1]},{"w": [5]}]},
    "import random, bisect\n"
    "class Solution:\n"
    "    def __init__(self,w):\n"
    "        self.pre=[]; s=0\n"
    "        for x in w: s+=x; self.pre.append(s)\n"
    "        self.total=s\n"
    "    def pickIndex(self):\n"
    "        t=random.randint(1,self.total)\n"
    "        return bisect.bisect_left(self.pre,t)\n")

print(len(TESTS))

# ---- run every task through the real Pyodide-bound harness (runner2.run_tests) ----
bad = []
for title, sp in TESTS.items():
    code = SOL[title]
    try:
        raw = R.run_tests(code, json.dumps(sp))
    except Exception as e:
        bad.append((title, "EXCEPTION", repr(e))); continue
    out = json.loads(raw)
    if out["fatal"]:
        bad.append((title, "FATAL", out["fatal"])); continue
    for r in out["res"]:
        if not r["ok"]:
            bad.append((title, r.get("i"), r.get("error"), r.get("got"), r.get("expected")))

print("problems:", len(bad))
for b in bad:
    print(b)

json.dump({"tests": TESTS, "sol": SOL}, open("new_tests2.json","w"), ensure_ascii=False, indent=1)
