add("Merge k Sorted Lists",
    {"kind": "solve", "arg_types": ["lists"], "ret_type": "list",
     "tests": [[[[1,4,5],[1,3,4],[2,6]],[1,1,2,3,4,4,5,6]],[[],[]],[[[]],[]]]},
    "import heapq\n"
    "def solve(lists):\n"
    "    h=[]\n"
    "    for i,n in enumerate(lists):\n"
    "        if n: heapq.heappush(h,(n.val,i,n))\n"
    "    dummy=cur=ListNode(0)\n"
    "    while h:\n"
    "        v,i,n=heapq.heappop(h)\n"
