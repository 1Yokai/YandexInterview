add("Reorder List",
    {"kind": "solve", "arg_types": ["list"], "ret_type": "list",
     "tests": [[[1,2,3,4],[1,4,2,3]],[[1,2,3,4,5],[1,5,2,4,3]]]},
    "def solve(head):\n"
    "    vals=[]\n"
    "    n=head\n"
    "    while n: vals.append(n.val); n=n.next\n"
    "    i,j=0,len(vals)-1\n"
    "    order=[]\n"
    "    while i<=j:\n"
    "        order.append(vals[i]); i+=1\n"
    "        if i<=j: order.append(vals[j]); j-=1\n"
    "    n=head\n"
    "    for v in order: n.val=v; n=n.next\n"
    "    return head\n")

