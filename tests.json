add("Lowest Common Ancestor of a Binary Search Tree",
    {"kind": "solve", "arg_types": ["tree","raw","raw"],
     "tests": [[[6,2,8,0,4,7,9,None,None,3,5],2,8,6],[[6,2,8,0,4,7,9,None,None,3,5],2,4,2],[[2,1],1,2,2]]},
    "def solve(root,p,q):\n"
    "    n=root\n"
    "    while n:\n"
    "        if p<n.val and q<n.val: n=n.left\n"
    "        elif p>n.val and q>n.val: n=n.right\n"
    "        else: return n.val\n")

