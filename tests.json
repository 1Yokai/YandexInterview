    "    def unfollow(self,followerId,followeeId):\n"
    "        self.follows[followerId].discard(followeeId)\n")

add("Insert Delete GetRandom O(1)",
    {"kind": "ops", "class_name": "RandomizedSet",
     "tests": [{"ops": ["RandomizedSet","insert","remove","insert","getRandom","remove","insert","getRandom"],
                "args": [[], [1], [2], [2], [], [1], [2], []],
                "expected": [None,True,False,True,1,True,False,2]}]},
    "import random\n"
    "class RandomizedSet:\n"
    "    def __init__(self): self.d={}; self.a=[]\n"
    "    def insert(self,val):\n"
    "        if val in self.d: return False\n"
    "        self.d[val]=len(self.a); self.a.append(val); return True\n"
    "    def remove(self,val):\n"
    "        if val not in self.d: return False\n"
    "        i=self.d[val]; last=self.a[-1]\n"
    "        self.a[i]=last; self.d[last]=i\n"
    "        self.a.pop(); del self.d[val]; return True\n"
    "    def getRandom(self): return random.choice(self.a)\n")

