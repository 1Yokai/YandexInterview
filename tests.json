    "    return dummy.next\n")

add("Reverse Nodes in k-Group",
    {"kind": "solve", "arg_types": ["list","raw"], "ret_type": "list",
     "tests": [[[1,2,3,4,5],2,[2,1,4,3,5]],[[1,2,3,4,5],3,[3,2,1,4,5]],[[1,2],3,[1,2]]]},
    "def solve(head,k):\n"
    "    node=head\n"
    "    for _ in range(k):\n"
    "        if not node: return head\n"
    "        node=node.next\n"
    "    prev=solve(node,k)\n"
    "    cur=head\n"
    "    for _ in range(k):\n"
    "        cur.next,prev,cur = prev,cur,cur.next\n"
    "    return prev\n")

