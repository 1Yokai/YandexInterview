add("Path Sum II",
    {"kind": "solve", "arg_types": ["tree","raw"], "unordered": True,
     "tests": [[[5,4,8,11,None,13,4,7,2,None,None,5,1],22,[[5,4,11,2],[5,8,4,5]]],[[1,2,3],5,[]]]},
    "def solve(root,target):\n"
    "    res=[]\n"
    "    def dfs(n,rem,path):\n"
    "        if not n: return\n"
    "        path=path+[n.val]; rem-=n.val\n"
    "        if not n.left and not n.right and rem==0: res.append(path); return\n"
    "        dfs(n.left,rem,path); dfs(n.right,rem,path)\n"
    "    dfs(root,target,[]); return res\n")

add("House Robber III",
