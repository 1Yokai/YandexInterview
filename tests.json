import json, importlib.util

spec_ = importlib.util.spec_from_file_location('runner2', 'runner2.py')
R = importlib.util.module_from_spec(spec_); spec_.loader.exec_module(R)

TESTS = {}   # title -> spec dict (kind, arg_types, ret_type, unordered, tests, class_name, template)
SOL = {}     # title -> reference solution source code

def add(title, spec, code):
    TESTS[title] = spec
    SOL[title] = code

# ---------- simple array task, no tree/list ----------
add("Find the Duplicate Number",
    {"kind": "solve", "tests": [[[1,3,4,2,2],2],[[3,1,3,4,2],3]]},
    "def solve(nums):\n"
    "    slow=fast=nums[0]\n"
    "    while True:\n"
    "        slow=nums[slow]; fast=nums[nums[fast]]\n"
    "        if slow==fast: break\n"
    "    slow2=nums[0]\n"
    "    while slow2!=slow:\n"
    "        slow2=nums[slow2]; slow=nums[slow]\n"
    "    return slow\n")

add("Генерация скобочных последовательностей",
    {"kind": "solve", "unordered": True,
     "tests": [[3,["((()))","(()())","(())()","()(())","()()()"]],[1,["()"]]]},
    "def solve(n):\n"
    "    res=[]\n"
    "    def bt(s,o,c):\n"
    "        if len(s)==2*n: res.append(s); return\n"
    "        if o<n: bt(s+'(',o+1,c)\n"
    "        if c<o: bt(s+')',o,c+1)\n"
    "    bt('',0,0); return res\n")

