add("Subtree of Another Tree",
    {"kind": "solve", "arg_types": ["tree","tree"],
     "tests": [[[3,4,5,1,2],[4,1,2],True],[[3,4,5,1,2,None,None,None,None,0],[4,1,2],False]]},
    "def same(a,b):\n"
    "    if not a and not b: return True\n"
    "    if not a or not b or a.val!=b.val: return False\n"
    "    return same(a.left,b.left) and same(a.right,b.right)\n"
    "def solve(root,subRoot):\n"
    "    if not root: return subRoot is None\n"
    "    if same(root,subRoot): return True\n"
    "    return solve(root.left,subRoot) or solve(root.right,subRoot)\n")

add("Balanced Binary Tree",
    {"kind": "solve", "arg_types": ["tree"],
     "tests": [[[3,9,20,None,None,15,7],True],[[1,2,2,3,3,None,None,4,4],False],[[],True]]},
    "def solve(root):\n"
    "    def h(n):\n"
    "        if not n: return 0\n"
    "        l=h(n.left)\n"
    "        if l==-1: return -1\n"
    "        r=h(n.right)\n"
    "        if r==-1: return -1\n"
    "        if abs(l-r)>1: return -1\n"
    "        return 1+max(l,r)\n"
    "    return h(root)!=-1\n")

