add("Construct Binary Tree from Preorder and Inorder Traversal",
    {"kind": "solve", "arg_types": ["raw","raw"], "ret_type": "tree",
     "tests": [[[3,9,20,15,7],[9,3,15,20,7],[3,9,20,None,None,15,7]],[[-1],[-1],[-1]]]},
    "def solve(preorder,inorder):\n"
    "    if not preorder: return None\n"
    "    root=TreeNode(preorder[0])\n"
    "    mid=inorder.index(preorder[0])\n"
    "    root.left=solve(preorder[1:mid+1],inorder[:mid])\n"
    "    root.right=solve(preorder[mid+1:],inorder[mid+1:])\n"
    "    return root\n")

add("Binary Tree Maximum Path Sum",
    {"kind": "solve", "arg_types": ["tree"],
     "tests": [[[1,2,3],6],[[-10,9,20,None,None,15,7],42]]},
    "def solve(root):\n"
    "    best=float('-inf')\n"
    "    def gain(n):\n"
    "        nonlocal best\n"
    "        if not n: return 0\n"
    "        l=max(gain(n.left),0); r=max(gain(n.right),0)\n"
    "        best=max(best,n.val+l+r)\n"
    "        return n.val+max(l,r)\n"
    "    gain(root); return best\n")

add("Serialize and Deserialize Binary Tree",
    {"kind": "serde", "tests": [[1,2,3,None,None,4,5],[],[1],[1,2]]},
    "def serialize(root):\n"
    "    vals=[]\n"
    "    def dfs(n):\n"
    "        if not n: vals.append('#'); return\n"
    "        vals.append(str(n.val)); dfs(n.left); dfs(n.right)\n"
    "    dfs(root); return ','.join(vals)\n"
    "def deserialize(data):\n"
    "    it=iter(data.split(','))\n"
    "    def build():\n"
    "        v=next(it)\n"
    "        if v=='#': return None\n"
    "        n=TreeNode(int(v)); n.left=build(); n.right=build(); return n\n"
    "    return build()\n")

